<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- For GIFs, and for the Lumen app to fetch its own updates. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the Lumen app install its updates; Android asks before each one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice typing: Android's speech service listens while you hold the microphone open. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Tells you when an update is out; the daily check survives restarts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The daily check waits for a connection; Android 14 and later refuse to schedule
         such a check for an app that doesn't declare this. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Finding the phone's speech service, for voice typing. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumen"
        tools:targetApi="31">

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ime.LumenIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Asks for the microphone on the keyboard's behalf. -->
        <activity
            android:name=".ime.VoicePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Hands a sent GIF to the receiving app, one read-only grant at a time. -->
        <provider
            android:name=".data.GifProvider"
            android:authorities="${applicationId}.gifs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Hears from Android's package installer while an update installs. -->
        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false" />

        <!-- The daily look for a new version. -->
        <service
            android:name=".update.UpdateCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
